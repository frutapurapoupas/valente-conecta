# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Mock Data Configuration
# Defina como 'true' para usar dados fictícios em desenvolvimento
# Defina como 'false' ou não defina para usar dados reais do Supabase
USE_MOCK=false

# Copie este arquivo para .env.local e preencha com suas credenciais do Supabase
