'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
import { 
  ShoppingBag, Bike, Dumbbell, Briefcase, Home as HomeIcon,
  Users, Wrench, Truck, Gift, Star, Clock, Shield, Store, Heart,
  TrendingUp, ChevronRight, Play, X, Crown, Handshake, Coffee,
  Pizza, Apple, Car, GraduationCap, HeartPulse, Scissors,
  Building2, Plane, Gamepad2, Bot, Utensils
} from 'lucide-react';
import BuscaInteligente from '@/components/busca/BuscaInteligente';
import { toast } from 'react-hot-toast';

// Categorias principais do app
const categorias = [
  { id: 'comercio', nome: 'Comércio', icon: Store, cor: 'bg-blue-500', href: '/catalogo?categoria=comercio' },
  { id: 'alimentacao', nome: 'Alimentação', icon: Pizza, cor: 'bg-orange-500', href: '/catalogo?categoria=alimentacao' },
  { id: 'academia', nome: 'Academia', icon: Dumbbell, cor: 'bg-red-500', href: '/academia' },
  { id: 'mototaxi', nome: 'Moto Táxi', icon: Bike, cor: 'bg-yellow-500', href: '/mototaxi' },
  { id: 'servicos', nome: 'Serviços', icon: Wrench, cor: 'bg-purple-500', href: '/servicos' },
  { id: 'profissionais', nome: 'Profissionais', icon: Users, cor: 'bg-indigo-500', href: '/profissionais' },
  { id: 'empregos', nome: 'Empregos', icon: Briefcase, cor: 'bg-teal-500', href: '/empregos' },
  { id: 'imoveis', nome: 'Imóveis', icon: Building2, cor: 'bg-pink-500', href: '/imoveis' },
  { id: 'veiculos', nome: 'Veículos', icon: Car, cor: 'bg-cyan-500', href: '/catalogo?categoria=veiculos' },
  { id: 'saude', nome: 'Saúde', icon: HeartPulse, cor: 'bg-emerald-500', href: '/catalogo?categoria=saude' },
  { id: 'educacao', nome: 'Educação', icon: GraduationCap, cor: 'bg-sky-500', href: '/catalogo?categoria=educacao' },
  { id: 'beleza', nome: 'Beleza', icon: Scissors, cor: 'bg-rose-500', href: '/catalogo?categoria=beleza' },
  { id: 'eventos', nome: 'Eventos', icon: Gamepad2, cor: 'bg-violet-500', href: '/catalogo?categoria=eventos' },
  { id: 'turismo', nome: 'Turismo', icon: Plane, cor: 'bg-amber-500', href: '/catalogo?categoria=turismo' }
];

// Pratos do dia - Cozinha Chef Neide
const ofertasDia = [
  { id: 1, titulo: '🍽️ Marmita Executiva', descricao: 'Arroz, feijão, frango grelhado, salada e farofa', preco: 18.90, original: 25.90, link: '/cozinha', badge: '🔥 Mais Pedido' },
  { id: 2, titulo: '🍝 Frango ao Molho', descricao: 'Frango grelhado com molho especial', preco: 22.90, original: 29.90, link: '/cozinha', badge: '⭐ Destaque' },
  { id: 3, titulo: '🥩 Carne de Panela', descricao: 'Carne macia com batatas', preco: 24.90, original: 32.90, link: '/cozinha', badge: '🎯 Promoção' },
  { id: 4, titulo: '🍛 Frango Xadrez', descricao: 'Frango com legumes agridoce', preco: 21.90, original: 28.90, link: '/cozinha', badge: '🌶️ Especial' }
];

// Banners publicitários
const banners = [
  { id: 1, titulo: 'Black Friday Valente', descricao: 'Descontos de até 70%', cor: 'bg-gradient-to-r from-red-600 to-orange-600', link: '/ofertas' },
  { id: 2, titulo: 'Indique e Ganhe', descricao: 'R$10 por indicação', cor: 'bg-gradient-to-r from-green-600 to-emerald-600', link: '/indicacoes' },
  { id: 3, titulo: 'App Premiado', descricao: 'Melhor app da região', cor: 'bg-gradient-to-r from-purple-600 to-pink-600', link: '/sobre' }
];

// Abas rotativas do card Indique
const abasIndique = [
  { texto: "🏆 Indique um amigo e ganhe R$10!", cor: "text-yellow-600" },
  { texto: "🎁 Indique uma loja e ganhe bônus!", cor: "text-green-600" },
  { texto: "💰 Indique um motorista e ganhe desconto!", cor: "text-blue-600" },
  { texto: "⭐ Indique um profissional e ganhe créditos!", cor: "text-purple-600" },
  { texto: "🏪 Indique um comerciante e ganhe comissão!", cor: "text-orange-600" },
  { texto: "💪 Indique a academia e ganhe mês grátis!", cor: "text-red-600" },
  { texto: "🚚 Indique o moto táxi e ganhe corrida!", cor: "text-yellow-700" },
  { texto: "🏠 Indique um imóvel e ganhe % da venda!", cor: "text-pink-600" },
  { texto: "📚 Indique um curso e ganhe desconto!", cor: "text-indigo-600" },
  { texto: "🎉 Indique um evento e ganhe ingresso!", cor: "text-amber-600" }
];

// Planos disponíveis
const planos = [
  { id: 'gratis', nome: 'Grátis', preco: 0, descricao: 'Básico', features: ['Perfil gratuito', '5 produtos', 'Contato básico'], icon: Users, cor: 'bg-gray-500' },
  { id: 'basico', nome: 'Básico', preco: 29.90, descricao: 'Para pequenos negócios', features: ['50 produtos', 'Contatos visíveis', 'Suporte prioritário'], icon: Store, cor: 'bg-blue-500' },
  { id: 'premium', nome: 'Premium', preco: 49.90, descricao: 'Para negócios em crescimento', features: ['Produtos ilimitados', 'PDV completo', 'Destaque na busca'], icon: Crown, cor: 'bg-yellow-500' },
  { id: 'fisco', nome: 'Fisco', preco: 99.90, descricao: 'Módulo fiscal completo', features: ['Nota fiscal', 'Contabilidade', 'Relatórios avançados'], icon: Shield, cor: 'bg-green-500' }
];

export default function HomePage() {
  const router = useRouter();
  const [bannerAtual, setBannerAtual] = useState(0);
  const [abaAtual, setAbaAtual] = useState(0);
  const [showVideo, setShowVideo] = useState(false);
  const [isAdmin, setIsAdmin] = useState(false);
  const [user, setUser] = useState<any>(null);

  useEffect(() => {
    const bannerInterval = setInterval(() => {
      setBannerAtual((prev) => (prev + 1) % banners.length);
    }, 10000);

    const abaInterval = setInterval(() => {
      setAbaAtual((prev) => (prev + 1) % abasIndique.length);
    }, 10000);

    const userData = localStorage.getItem('user');
    if (userData) {
      try {
        const parsed = JSON.parse(userData);
        setUser(parsed);
        setIsAdmin(parsed.isAdmin === true);
      } catch (e) {}
    }

    return () => {
      clearInterval(bannerInterval);
      clearInterval(abaInterval);
    };
  }, []);

  const handleIndicarClick = () => {
    if (!user) {
      toast.error('Faça login para indicar amigos');
      router.push('/login');
      return;
    }
    router.push('/indicacoes');
  };

  const handleSearchResult = (produto: any) => {
    window.location.href = `/catalogo/produto/${produto.id}`;
  };

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header Azul */}
      <header className="bg-gradient-to-r from-blue-600 to-indigo-600 text-white sticky top-0 z-50 shadow-lg">
        <div className="container mx-auto px-4 py-3">
          <div className="flex justify-between items-center">
            <div className="flex items-center gap-2">
              <span className="text-2xl">🏪</span>
              <span className="font-bold text-lg hidden sm:block">Valente Conecta</span>
            </div>
            <div className="text-sm">📍 Valente, BA</div>
            {isAdmin && (
              <Link href="/admin" className="p-2 rounded-full bg-white/20 hover:bg-white/30">
                <Shield className="w-5 h-5" />
              </Link>
            )}
          </div>
        </div>
      </header>

      {/* Busca Inteligente */}
      <div className="bg-white shadow-md py-4 sticky top-[57px] z-40">
        <div className="container mx-auto px-4">
          <BuscaInteligente onResultadoClick={handleSearchResult} placeholder="🔍 Buscar produtos, serviços, profissionais..." />
        </div>
      </div>

      <main className="container mx-auto px-4 py-6">
        
        {/* Card Cozinha Chef Neide - largura total, sozinho */}
        <div className="bg-gradient-to-r from-amber-500 to-orange-600 rounded-2xl p-4 mb-6 text-white shadow-lg">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-2">
              <Utensils className="w-6 h-6" />
              <h2 className="font-bold text-lg">COZINHA CHEF NEIDE</h2>
            </div>
            <Link href="/cozinha" className="text-sm underline">Ver cardápio completo</Link>
          </div>
          <div className="overflow-x-auto mt-3 pb-2">
            <div className="flex gap-3" style={{ minWidth: 'max-content' }}>
              {ofertasDia.map((oferta) => (
                <Link href={oferta.link} key={oferta.id}>
                  <div className="bg-white/10 rounded-xl p-3 min-w-[160px] backdrop-blur-sm hover:bg-white/20 transition-all cursor-pointer">
                    <div className="flex items-center justify-between mb-2">
                      <div className="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center text-2xl">
                        {oferta.titulo.charAt(0)}
                      </div>
                      {oferta.badge && <span className="text-[10px] bg-yellow-500 text-white px-2 py-0.5 rounded-full">{oferta.badge}</span>}
                    </div>
                    <p className="font-semibold text-sm">{oferta.titulo}</p>
                    <p className="text-xs opacity-90 line-clamp-2">{oferta.descricao}</p>
                    <div className="mt-2">
                      {oferta.preco > 0 ? (
                        <>
                          <span className="text-lg font-bold">R$ {oferta.preco.toFixed(2)}</span>
                          <span className="text-xs line-through opacity-70 ml-2">R$ {oferta.original.toFixed(2)}</span>
                        </>
                      ) : (
                        <span className="text-sm font-semibold">🎁 Grátis!</span>
                      )}
                    </div>
                  </div>
                </Link>
              ))}
            </div>
          </div>
        </div>

        {/* Card Indique e Ganhe */}
        <div className="bg-gradient-to-r from-green-600 to-emerald-600 rounded-2xl p-4 mb-6 text-white shadow-lg cursor-pointer hover:shadow-xl transition-shadow" onClick={handleIndicarClick}>
          <div className="flex items-center justify-between flex-wrap gap-3">
            <div className="flex items-center gap-2">
              <Handshake className="w-6 h-6" />
              <h2 className="font-bold text-lg">INDICAÇÃO PREMIADA</h2>
            </div>
            <button onClick={(e) => { e.stopPropagation(); handleIndicarClick(); }} className="bg-white text-green-700 px-4 py-2 rounded-lg font-semibold text-sm hover:bg-green-50">
              Indicar Agora
            </button>
          </div>
          <div className="mt-3 h-12 flex items-center">
            <p className={`text-sm font-medium ${abasIndique[abaAtual].cor} bg-white/20 px-3 py-1 rounded-full inline-block transition-all duration-500`}>
              {abasIndique[abaAtual].texto}
            </p>
          </div>
        </div>

        {/* Categorias em Destaque */}
        <div className="mb-8">
          <h2 className="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2">
            <TrendingUp className="w-5 h-5 text-blue-600" />
            Categorias em Destaque
          </h2>
          <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3">
            {categorias.map((cat) => {
              const Icon = cat.icon;
              return (
                <Link key={cat.id} href={cat.href} className="bg-white rounded-xl p-3 text-center hover:shadow-md transition-shadow border border-gray-100">
                  <div className={`${cat.cor} w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-2`}>
                    <Icon className="w-6 h-6 text-white" />
                  </div>
                  <span className="text-sm font-medium text-gray-700">{cat.nome}</span>
                </Link>
              );
            })}
          </div>
        </div>

        {/* Carrossel Publicidade */}
        <div className="mb-8">
          <div className="relative rounded-2xl overflow-hidden h-32 md:h-40">
            {banners.map((banner, index) => (
              <div key={banner.id} className={`absolute inset-0 transition-opacity duration-500 ${index === bannerAtual ? 'opacity-100' : 'opacity-0'}`}>
                <Link href={banner.link} className={`${banner.cor} w-full h-full flex items-center justify-center p-6`}>
                  <div className="text-center text-white">
                    <h3 className="text-xl md:text-2xl font-bold">{banner.titulo}</h3>
                    <p className="text-sm md:text-base opacity-90">{banner.descricao}</p>
                    <span className="inline-block mt-2 text-sm underline">Saiba mais</span>
                  </div>
                </Link>
              </div>
            ))}
            <div className="absolute bottom-3 left-0 right-0 flex justify-center gap-2">
              {banners.map((_, index) => (
                <button key={index} onClick={() => setBannerAtual(index)} className={`w-2 h-2 rounded-full transition-all ${index === bannerAtual ? 'bg-white w-4' : 'bg-white/50'}`} />
              ))}
            </div>
          </div>
        </div>

        {/* Vídeo Lançamento */}
        <div className="mb-8">
          <button onClick={() => setShowVideo(true)} className="w-full bg-gradient-to-r from-gray-900 to-gray-800 rounded-2xl p-6 text-center hover:from-gray-800 hover:to-gray-700">
            <div className="flex items-center justify-center gap-3">
              <div className="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center"><Play className="w-8 h-8 text-white" /></div>
              <div className="text-left"><p className="text-white font-bold">Assista ao Vídeo</p><p className="text-gray-300 text-sm">Conheça o Valente Conecta</p></div>
            </div>
          </button>
        </div>

        {/* Seção Planos */}
        <div className="mb-8">
          <h2 className="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2"><Crown className="w-5 h-5 text-yellow-600" /> Planos para seu Negócio</h2>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {planos.map((plano) => {
              const Icon = plano.icon;
              return (
                <div key={plano.id} className="bg-white rounded-xl p-4 border border-gray-200 hover:shadow-lg">
                  <div className={`${plano.cor} w-12 h-12 rounded-full flex items-center justify-center mb-3`}><Icon className="w-6 h-6 text-white" /></div>
                  <h3 className="font-bold text-gray-800">{plano.nome}</h3>
                  <p className="text-2xl font-bold text-gray-900 mt-1">{plano.preco === 0 ? 'Grátis' : `R$ ${plano.preco.toFixed(2)}`}{plano.preco > 0 && <span className="text-sm font-normal text-gray-500">/mês</span>}</p>
                  <p className="text-sm text-gray-500 mt-1">{plano.descricao}</p>
                  <ul className="mt-3 space-y-1">{plano.features.map((feature, idx) => (<li key={idx} className="text-xs text-gray-600 flex items-center gap-1"><ChevronRight className="w-3 h-3 text-green-500" /> {feature}</li>))}</ul>
                  <button className="mt-4 w-full bg-blue-600 text-white py-2 rounded-lg text-sm font-semibold hover:bg-blue-700">Assinar</button>
                </div>
              );
            })}
          </div>
        </div>

        {/* Estatísticas */}
        <div className="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl p-6 text-white">
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
            <div><div className="text-2xl font-bold">1000+</div><div className="text-sm opacity-90">Usuários Ativos</div></div>
            <div><div className="text-2xl font-bold">50+</div><div className="text-sm opacity-90">Lojas Parceiras</div></div>
            <div><div className="text-2xl font-bold">100+</div><div className="text-sm opacity-90">Profissionais</div></div>
            <div><div className="text-2xl font-bold">5000+</div><div className="text-sm opacity-90">Pedidos Realizados</div></div>
          </div>
        </div>
      </main>

      {/* Modal do Vídeo */}
      {showVideo && (
        <div className="fixed inset-0 bg-black bg-opacity-90 flex items-center justify-center z-50 p-4">
          <div className="relative max-w-3xl w-full">
            <button onClick={() => setShowVideo(false)} className="absolute -top-10 right-0 text-white hover:text-gray-300"><X className="w-6 h-6" /></button>
            <div className="bg-black rounded-xl overflow-hidden aspect-video">
              <iframe width="100%" height="100%" src="https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1" title="Vídeo Valente Conecta" frameBorder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowFullScreen></iframe>
            </div>
          </div>
        </div>
      )}

      {/* Botão Admin Master */}
      {isAdmin && (
        <Link href="/admin" className="fixed bottom-6 right-6 bg-gradient-to-r from-gray-800 to-gray-900 text-white p-3 rounded-full shadow-lg hover:shadow-xl z-50">
          <Shield className="w-6 h-6" />
        </Link>
      )}
    </div>
  );
}