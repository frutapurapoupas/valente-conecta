// app/admin-master/cozinha/receitas/page.tsx
"use client";

import { useState } from 'react';
import { useRouter } from 'next/navigation';
import { useReceitas } from '@/src/modules/cozinha/hooks/useReceitas';
import { ReceitaList } from '../components/ReceitaList';

export default function ReceitasPage() {
  const router = useRouter();
  const [showForm, setShowForm] = useState(false);
  const { receitas, loading, excluir } = useReceitas();

  return (
    <div className="p-6">
      <div className="flex justify-between items-center mb-6">
        <div>
          <h1 className="text-2xl font-bold text-gray-800">📋 Receitas</h1>
          <p className="text-gray-500 mt-1">Gerencie todas as receitas da cozinha</p>
        </div>
        <button
          onClick={() => setShowForm(true)}
          className="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition-colors"
        >
          + Nova Receita
        </button>
      </div>

      <ReceitaList
        receitas={receitas}
        loading={loading}
        onDelete={excluir}
        onEdit={(id) => router.push(`/admin-master/cozinha/receitas/${id}/editar`)}
      />

      {showForm && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center">
          <div className="bg-white rounded-lg p-6 max-w-md w-full">
            <h2 className="text-xl font-bold mb-4">Nova Receita</h2>
            <p className="text-gray-500">Formulário de criação de receita não implementado.</p>
            <button
              onClick={() => setShowForm(false)}
              className="mt-4 px-4 py-2 bg-gray-200 rounded hover:bg-gray-300"
            >
              Fechar
            </button>
          </div>
        </div>
      )}
    </div>
  );
}