'use client';

import { useState, useEffect } from 'react';

interface Ingredient {
  id: string;
  name: string;
  category: string;
  unit: string;
  stock: number;
  minStock: number;
  currentPrice: number;
  volumeMl?: number;
  pesoPorUnidade?: number; // Peso em gramas por unidade (para ovo, maÃ§o, etc)
  gramasPorEmbalagem?: number; // Peso da embalagem em gramas
  unidadesPlaca?: number; // NOVO: Quantos ovos vÃªm na placa
}

interface CompraLote {
  ingredientId: string;
  quantidadeUnidades: number;
  pesoTotalGramas: number;
  valorPago: number;
  data: string;
}

const categories = [
  { value: 'alimento', label: 'ðŸ¥© Alimento' },
  { value: 'bebida', label: 'ðŸ¥¤ Bebida' },
  { value: 'embalagem', label: 'ðŸ“¦ Embalagem' },
  { value: 'tempero', label: 'ðŸ§‚ Tempero' },
  { value: 'liquido', label: 'ðŸ’§ LÃ­quido' },
  { value: 'por_peso', label: 'âš–ï¸ Por Peso (maÃ§o, molho)' }
];

const units = [
  { value: 'kg', label: 'Quilograma (kg) - Para pesos grandes' },
  { value: 'g', label: 'Grama (g) - Para pesos pequenos' },
  { value: 'L', label: 'Litro (L) - Para lÃ­quidos' },
  { value: 'mL', label: 'Mililitro (mL) - Para lÃ­quidos em pequena quantidade' },
  { value: 'unidade', label: 'Unidade - Para itens contados individualmente' },
  { value: 'maco', label: 'MaÃ§o - Para temperos e ervas' }
];

export default function IngredientesPage() {
  const [ingredients, setIngredients] = useState<Ingredient[]>([]);
  const [loading, setLoading] = useState(true);
  const [showModal, setShowModal] = useState(false);
  const [showCompraModal, setShowCompraModal] = useState(false);
  const [selectedIngredient, setSelectedIngredient] = useState<Ingredient | null>(null);
  const [editingIngredient, setEditingIngredient] = useState<Ingredient | null>(null);
  const [searchTerm, setSearchTerm] = useState('');
  const [showLowStock, setShowLowStock] = useState(false);
  const [selectedCategory, setSelectedCategory] = useState('');

  // Estados especÃ­ficos para OVO
  const [isOvo, setIsOvo] = useState(false);
  const [pesoOvo, setPesoOvo] = useState(50);
  const [unidadesPlaca, setUnidadesPlaca] = useState(30);

  const [formData, setFormData] = useState({
    name: '',
    category: 'alimento',
    unit: 'kg',
    stock: 0,
    minStock: 0,
    currentPrice: 0,
    volumeMl: null,
    pesoPorUnidade: null,
    gramasPorEmbalagem: 0
  });

  const [compraData, setCompraData] = useState({
    quantidadeUnidades: 1,
    pesoTotalGramas: 0,
    valorPago: 0
  });

  useEffect(() => {
    loadIngredients();
  }, [showLowStock, selectedCategory, searchTerm]);

  const loadIngredients = async () => {
    try {
      let url = '/api/cozinha/ingredients';

      const response = await fetch(url);
      const data = await response.json();

      if (data.success) {
        let filteredData = data.data;

        if (selectedCategory) {
          filteredData = filteredData.filter((i: Ingredient) => i.category === selectedCategory);
        }

        if (searchTerm) {
          filteredData = filteredData.filter((i: Ingredient) =>
            i.name.toLowerCase().includes(searchTerm.toLowerCase())
          );
        }

        if (showLowStock) {
          filteredData = filteredData.filter((i: Ingredient) => i.stock <= i.minStock);
        }

        setIngredients(filteredData);
      }
    } catch (error) {
      console.error('Erro ao carregar ingredientes:', error);
    } finally {
      setLoading(false);
    }
  };

  const calcularPrecoUnitario = (precoTotal: number, unidade: string, volumeMl?: number, pesoPorUnidade?: number, gramasPorEmbalagem?: number): number => {
    if (unidade === 'g' && gramasPorEmbalagem && gramasPorEmbalagem > 0) {
      return precoTotal / gramasPorEmbalagem;
    }
    if (unidade === 'L' && volumeMl && volumeMl > 0) {
      return (precoTotal / volumeMl) * 1000;
    }
    if (unidade === 'mL' && volumeMl && volumeMl > 0) {
      return precoTotal / volumeMl;
    }
    if ((unidade === 'maco' || unidade === 'unidade') && pesoPorUnidade && pesoPorUnidade > 0) {
      return precoTotal / pesoPorUnidade;
    }
    if (unidade === 'kg' && pesoPorUnidade && pesoPorUnidade > 0) {
      return precoTotal / (pesoPorUnidade / 1000);
    }
    return precoTotal;
  };

  const handleRegistrarCompra = async () => {
    if (!selectedIngredient) return;

    const isOvoIngrediente = selectedIngredient.name.toLowerCase().includes('ovo');
    const unidadesPorPlaca = selectedIngredient.unidadesPlaca || 30;
    const pesoUnidadeOvo = selectedIngredient.pesoPorUnidade || 50;

    if (compraData.quantidadeUnidades <= 0) {
      alert('âŒ Informe a quantidade de unidades/placas compradas');
      return;
    }

    if (compraData.pesoTotalGramas <= 0 && selectedIngredient.unit === 'g' && !isOvoIngrediente) {
      alert('âŒ Informe o peso total da compra em gramas');
      return;
    }

    if (compraData.valorPago <= 0) {
      alert('âŒ Informe o valor pago');
      return;
    }

    let novoEstoque = 0;
    let novoPreco = 0;
    let novaPesoUnidade = pesoUnidadeOvo;

    // CÃ¡lculo especial para OVO
    if (isOvoIngrediente) {
      // PreÃ§o por kg = (valor_placa / (unidades_placa * peso_unidade)) * 1000
      const precoPorKilo = (compraData.valorPago / (unidadesPorPlaca * pesoUnidadeOvo)) * 1000;
      novoPreco = precoPorKilo;
      
      // Atualizar estoque em kg
      novoEstoque = (selectedIngredient.stock || 0) + (compraData.quantidadeUnidades * unidadesPorPlaca * pesoUnidadeOvo) / 1000;
      
      alert(`âœ… Compra de OVO registrada!\n` +
        `ðŸ“¦ PreÃ§o por kg: R$ ${novoPreco.toFixed(2)}\n` +
        `ðŸ¥š ${compraData.quantidadeUnidades} placa(s) = ${compraData.quantidadeUnidades * unidadesPorPlaca} ovos\n` +
        `âš–ï¸ Peso total: ${((compraData.quantidadeUnidades * unidadesPorPlaca * pesoUnidadeOvo) / 1000).toFixed(2)}kg`);
    }
    // Para ingredientes em gramas (g)
    else if (selectedIngredient.unit === 'g') {
      const pesoPorUnidade = compraData.pesoTotalGramas / compraData.quantidadeUnidades;
      const precoPorGrama = compraData.valorPago / compraData.pesoTotalGramas;
      novoPreco = precoPorGrama * 1000;
      novoEstoque = (selectedIngredient.stock || 0) + (compraData.pesoTotalGramas / 1000);
      
      await fetch(`/api/cozinha/ingredients?id=${selectedIngredient.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          stock: novoEstoque,
          currentPrice: novoPreco,
          pesoPorUnidade: pesoPorUnidade
        })
      });
      
      alert(`âœ… Compra registrada! Novo preÃ§o: R$ ${novoPreco.toFixed(2)}/kg | Estoque: ${novoEstoque.toFixed(2)}kg | Peso mÃ©dio: ${pesoPorUnidade.toFixed(1)}g/unidade`);
    } 
    // Para lÃ­quidos
    else if (selectedIngredient.unit === 'L' || selectedIngredient.unit === 'mL') {
      const volumeTotal = selectedIngredient.volumeMl || 0;
      const precoPorMl = compraData.valorPago / (compraData.quantidadeUnidades * volumeTotal);
      novoPreco = precoPorMl * 1000;
      novoEstoque = (selectedIngredient.stock || 0) + (compraData.quantidadeUnidades * volumeTotal / 1000);
      
      await fetch(`/api/cozinha/ingredients?id=${selectedIngredient.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          stock: novoEstoque,
          currentPrice: novoPreco
        })
      });
      
      alert(`âœ… Compra registrada! Novo preÃ§o: R$ ${novoPreco.toFixed(2)}/L`);
    }
    else {
      // Para outros tipos
      const precoPorUnidade = compraData.valorPago / compraData.quantidadeUnidades;
      novoEstoque = (selectedIngredient.stock || 0) + compraData.quantidadeUnidades;
      
      await fetch(`/api/cozinha/ingredients?id=${selectedIngredient.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          stock: novoEstoque,
          currentPrice: precoPorUnidade
        })
      });
      
      alert(`âœ… Compra registrada! Novo preÃ§o: R$ ${precoPorUnidade.toFixed(2)}/${selectedIngredient.unit}`);
    }

    await loadIngredients();
    setShowCompraModal(false);
    setCompraData({ quantidadeUnidades: 1, pesoTotalGramas: 0, valorPago: 0 });
    setSelectedIngredient(null);
  };

  const abrirCompraModal = (ingredient: Ingredient) => {
    setSelectedIngredient(ingredient);
    setCompraData({
      quantidadeUnidades: 1,
      pesoTotalGramas: ingredient.pesoPorUnidade || 0,
      valorPago: 0
    });
    setShowCompraModal(true);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();

    if (!formData.name.trim()) {
      alert('âŒ O nome do ingrediente Ã© obrigatÃ³rio');
      return;
    }

    // VERIFICAÃ‡ÃƒO ESPECIAL PARA OVO
    const isOvoIngrediente = formData.name.toLowerCase().includes('ovo');
    
    if (isOvoIngrediente) {
      if (!pesoOvo || pesoOvo <= 0) {
        alert('âŒ Para OVO, informe o peso padrÃ£o da unidade (ex: 50g)');
        return;
      }
      if (!unidadesPlaca || unidadesPlaca <= 0) {
        alert('âŒ Para OVO, informe quantas unidades vÃªm na placa');
        return;
      }
    }

    if ((formData.category === 'liquido' || formData.unit === 'L' || formData.unit === 'mL') && formData.volumeMl <= 0) {
      alert('âŒ Para ingredientes lÃ­quidos, informe o volume da embalagem (ex: 900ml)');
      return;
    }

    if (formData.unit === 'g' && formData.gramasPorEmbalagem <= 0 && !isOvoIngrediente) {
      alert('âŒ Para ingredientes em gramas (g), informe quantas gramas tem a embalagem');
      return;
    }

    if (formData.currentPrice <= 0 && !isOvoIngrediente) {
      alert('âŒ O preÃ§o deve ser maior que zero');
      return;
    }

    let finalPrice = formData.currentPrice;
    let finalPesoPorUnidade = null;
    let finalUnidadesPlaca = null;

    // CÃ¡lculo especial para OVO
    if (isOvoIngrediente) {
      // PreÃ§o por kg = (preco_placa / (unidades_placa * peso_unidade)) * 1000
      const precoPorKilo = (formData.currentPrice / (unidadesPlaca * pesoOvo)) * 1000;
      finalPrice = precoPorKilo;
      finalPesoPorUnidade = pesoOvo;
      finalUnidadesPlaca = unidadesPlaca;
    }
    // Para itens em gramas (g) com peso da embalagem
    else if (formData.unit === 'g' && formData.gramasPorEmbalagem > 0) {
      finalPrice = formData.currentPrice / formData.gramasPorEmbalagem;
      finalPesoPorUnidade = formData.gramasPorEmbalagem;
    }
    // Para lÃ­quidos
    else if (formData.category === 'liquido' || formData.unit === 'L' || formData.unit === 'mL') {
      finalPrice = calcularPrecoUnitario(formData.currentPrice, formData.unit, formData.volumeMl);
    }
    // Para itens por peso
    else if (formData.category === 'por_peso' || formData.unit === 'maco') {
      if (formData.pesoPorUnidade <= 0) {
        alert('âŒ Para itens por peso (maÃ§o), informe o peso mÃ©dio por unidade em gramas');
        return;
      }
      finalPrice = calcularPrecoUnitario(formData.currentPrice, formData.unit, undefined, formData.pesoPorUnidade);
    }

    try {
      let url = '/api/cozinha/ingredients';
      let method = 'POST';
      let body: any = {
        name: formData.name.trim(),
        category: formData.category,
        unit: formData.unit,
        stock: Number(formData.stock),
        minStock: Number(formData.minStock),
        currentPrice: finalPrice,
        volumeMl: (formData.category === 'liquido' || formData.unit === 'L' || formData.unit === 'mL') ? formData.volumeMl : null,
        pesoPorUnidade: finalPesoPorUnidade || (formData.pesoPorUnidade || null),
        unidadesPlaca: finalUnidadesPlaca || null
      };

      if (editingIngredient) {
        method = 'PUT';
        body.id = editingIngredient.id;
        url = `/api/cozinha/ingredients?id=${editingIngredient.id}`;
      }

      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });

      const result = await response.json();

      if (result.success) {
        await loadIngredients();
        setShowModal(false);
        resetForm();
        alert(editingIngredient ? 'âœ… Ingrediente atualizado!' : 'âœ… Ingrediente criado!');
      } else {
        alert(`âŒ Erro: ${result.error || 'NÃ£o foi possÃ­vel salvar'}`);
      }
    } catch (error) {
      console.error('Erro ao salvar ingrediente:', error);
      alert('âŒ Erro ao salvar ingrediente');
    }
  };

  const handleDelete = async (id: string) => {
    if (confirm('âš ï¸ Tem certeza que deseja remover este ingrediente?')) {
      try {
        const response = await fetch(`/api/cozinha/ingredients?id=${id}`, { method: 'DELETE' });
        const result = await response.json();

        if (result.success) {
          await loadIngredients();
          alert('âœ… Ingrediente removido!');
        } else {
          alert('âŒ Erro ao remover');
        }
      } catch (error) {
        console.error('Erro ao remover ingrediente:', error);
        alert('âŒ Erro ao remover');
      }
    }
  };

  const resetForm = () => {
    setFormData({
      name: '',
      category: 'alimento',
      unit: 'kg',
      stock: 0,
      minStock: 0,
      currentPrice: 0,
      volumeMl: null,
      pesoPorUnidade: null,
      gramasPorEmbalagem: 0
    });
    setEditingIngredient(null);
    setPesoOvo(50);
    setUnidadesPlaca(30);
  };

  const editIngredient = (ingredient: Ingredient) => {
    setEditingIngredient(ingredient);
    setFormData({
      name: ingredient.name,
      category: ingredient.category,
      unit: ingredient.unit,
      stock: ingredient.stock,
      minStock: ingredient.minStock,
      currentPrice: ingredient.currentPrice,
      volumeMl: ingredient.volumeMl || 0,
      pesoPorUnidade: ingredient.pesoPorUnidade || 0,
      gramasPorEmbalagem: ingredient.gramasPorEmbalagem || 0
    });
    if (ingredient.name.toLowerCase().includes('ovo')) {
      setPesoOvo(ingredient.pesoPorUnidade || 50);
      setUnidadesPlaca(ingredient.unidadesPlaca || 30);
    } else {
      setPesoOvo(50);
      setUnidadesPlaca(30);
    }
    setShowModal(true);
  };

  const getStockStatus = (ingredient: Ingredient) => {
    if (ingredient.stock <= 0) return { text: 'Esgotado', class: 'bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200' };
    if (ingredient.stock < ingredient.minStock) return { text: 'Baixo', class: 'bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200' };
    return { text: 'Normal', class: 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200' };
  };

  const getUnitDisplay = (ingredient: Ingredient) => {
    if (ingredient.category === 'liquido' && ingredient.volumeMl) {
      return `${ingredient.unit} (${ingredient.volumeMl}ml)`;
    }
    if ((ingredient.category === 'por_peso' || ingredient.unit === 'maco') && ingredient.pesoPorUnidade) {
      return `${ingredient.unit} (~${ingredient.pesoPorUnidade}g)`;
    }
    if (ingredient.unit === 'g' && ingredient.pesoPorUnidade) {
      return `${ingredient.unit} (${ingredient.pesoPorUnidade}g/emb)`;
    }
    if (ingredient.name.toLowerCase().includes('ovo') && ingredient.pesoPorUnidade && ingredient.unidadesPlaca) {
      return `${ingredient.unit} (${ingredient.pesoPorUnidade}g/ovo, ${ingredient.unidadesPlaca}/placa)`;
    }
    return ingredient.unit;
  };

  if (loading) return <div className="p-8 text-center text-gray-900 dark:text-gray-100">ðŸ”„ Carregando ingredientes...</div>;

  return (
    <div className="p-6">
      <div className="flex justify-between items-center mb-6">
        <div>
          <h1 className="text-2xl font-bold text-gray-900 dark:text-white">ðŸ“¦ Ingredientes</h1>
          <p className="text-sm text-gray-500 dark:text-gray-400 mt-1">Gerencie todos os insumos da cozinha</p>
        </div>
        <button
          onClick={() => {
            resetForm();
            setShowModal(true);
          }}
          className="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors flex items-center gap-2"
        >
          <span>+</span> Novo Ingrediente
        </button>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div>
          <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">ðŸ” Buscar</label>
          <input
            type="text"
            placeholder="Digite o nome do ingrediente..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500"
          />
        </div>
        <div>
          <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">ðŸ“‚ Categoria</label>
          <select
            value={selectedCategory}
            onChange={(e) => setSelectedCategory(e.target.value)}
            className="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500"
          >
            <option value="">Todas as categorias</option>
            {categories.map(cat => (
              <option key={cat.value} value={cat.value}>{cat.label}</option>
            ))}
          </select>
        </div>
        <div className="flex items-end">
          <label className="flex items-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 cursor-pointer">
            <input
              type="checkbox"
              checked={showLowStock}
              onChange={(e) => setShowLowStock(e.target.checked)}
              className="w-4 h-4"
            />
            <span>âš ï¸ Apenas itens com estoque baixo</span>
          </label>
        </div>
      </div>

      <div className="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead className="bg-gray-50 dark:bg-gray-700">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Nome</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Categoria</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Estoque</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">MÃ­nimo</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">PreÃ§o</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
                <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">AÃ§Ãµes</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-200 dark:divide-gray-700">
              {ingredients.length === 0 ? (
                <tr>
                  <td colSpan={7} className="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
                    ðŸ“­ Nenhum ingrediente encontrado
                  </td>
                </tr>
              ) : (
                ingredients.map((ingredient) => {
                  const status = getStockStatus(ingredient);
                  return (
                    <tr key={ingredient.id} className="hover:bg-gray-50 dark:hover:bg-gray-700">
                      <td className="px-6 py-4 whitespace-nowrap font-medium text-gray-900 dark:text-white">{ingredient.name}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-gray-600 dark:text-gray-400">{categories.find(c => c.value === ingredient.category)?.label || ingredient.category}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-gray-600 dark:text-gray-400">
                        {ingredient.unit === 'g' 
                          ? `${(ingredient.stock * 1000).toFixed(0)} ${getUnitDisplay(ingredient)}`
                          : `${ingredient.stock} ${getUnitDisplay(ingredient)}`}
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-gray-600 dark:text-gray-400">
                        {ingredient.minStock} {ingredient.unit}
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-gray-600 dark:text-gray-400">
                        {ingredient.unit === 'g' 
                          ? `R$ ${(ingredient.currentPrice / 1000).toFixed(2)}/${ingredient.unit}`
                          : `R$ ${ingredient.currentPrice.toFixed(2)}/${ingredient.unit}`}
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap">
                        <span className={`px-2 py-1 rounded-full text-xs font-medium ${status.class}`}>
                          {status.text}
                        </span>
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-right">
                        <button
                          onClick={() => editIngredient(ingredient)}
                          className="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 mr-3 transition-colors"
                          title="Editar"
                        >
                          âœï¸
                        </button>
                        <button
                          onClick={() => abrirCompraModal(ingredient)}
                          className="text-green-600 dark:text-green-400 hover:text-green-800 dark:hover:text-green-300 mr-3 transition-colors"
                          title="Registrar Compra"
                        >
                          ðŸ›’
                        </button>
                        <button
                          onClick={() => handleDelete(ingredient.id)}
                          className="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 transition-colors"
                          title="Remover"
                        >
                          ðŸ—‘ï¸
                        </button>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </div>

      {/* Modal de Cadastro/EdiÃ§Ã£o */}
      {showModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white dark:bg-gray-800 rounded-lg p-6 w-full max-w-md max-h-[90vh] overflow-y-auto">
            <div className="flex justify-between items-center mb-4">
              <h2 className="text-xl font-bold text-gray-900 dark:text-white">
