'use client';

import { useState, useEffect } from 'react';
import { Image as ImageIcon, X } from 'lucide-react';

interface RecipeFull {
  id: string;
  name: string;
  category: string;
  sellingPrice: number;
  description?: string;
  image?: string;
}

interface MenuItem {
  id: string;
  recipeId: string;
  dayOfWeek?: number;
  period?: string;
  isAvailable: boolean;
  customPrice?: number;
  recipe: RecipeFull;
}

const daysOfWeek = [
  { value: 0, label: 'Domingo' },
  { value: 1, label: 'Segunda' },
  { value: 2, label: 'Terça' },
  { value: 3, label: 'Quarta' },
  { value: 4, label: 'Quinta' },
  { value: 5, label: 'Sexta' },
  { value: 6, label: 'Sábado' },
  { value: null, label: 'Todos os dias' }
];

const periods = [
  { value: 'almoco', label: 'Almoço' },
  { value: 'jantar', label: 'Jantar' },
  { value: 'cafe', label: 'Café da Manhã' },
  { value: null, label: 'Todos os períodos' }
];

export default function CardapioPage() {
  const [menuItems, setMenuItems] = useState<MenuItem[]>([]);
  const [recipes, setRecipes] = useState<RecipeFull[]>([]);
  const [loading, setLoading] = useState(true);
  const [showModal, setShowModal] = useState(false);
  const [editingItem, setEditingItem] = useState<MenuItem | null>(null);
  const [selectedImage, setSelectedImage] = useState<string | null>(null);
  const [formData, setFormData] = useState({
    recipeId: '',
    dayOfWeek: null as number | null,
    period: null as string | null,
    customPrice: null as number | null,
    isAvailable: true
  });

  useEffect(() => {
    loadMenu();
    loadRecipes();
  }, []);

  const loadMenu = async () => {
    try {
      const response = await fetch('/api/admin/menu');
      const data = await response.json();
      setMenuItems(data);
    } catch (error) {
      console.error('Erro ao carregar cardápio:', error);
    } finally {
      setLoading(false);
    }
  };

  const loadRecipes = async () => {
    try {
      const response = await fetch('/api/cozinha/recipes');
      const data = await response.json();
      if (data.success) {
        const formattedRecipes = data.data.map((r: any) => ({
          id: r.id,
          name: r.name,
          category: r.category,
          sellingPrice: r.price,
          description: r.description || '',
          image: r.image || null
        }));
        setRecipes(formattedRecipes);
      }
    } catch (error) {
      console.error('Erro ao carregar receitas:', error);
    }
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    
    if (!formData.recipeId) {
      alert('Selecione uma receita');
      return;
    }
    
    try {
      const url = '/api/admin/menu';
      const method = editingItem ? 'PUT' : 'POST';
      
      // CORREÇÃO: Colocar o ID no BODY para PUT
      const body = editingItem 
        ? { id: editingItem.id, ...formData }
        : formData;
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      
      if (response.ok) {
        await loadMenu();
        setShowModal(false);
        resetForm();
      } else {
        const error = await response.json();
        alert(error.error || 'Erro ao salvar');
      }
    } catch (error) {
      console.error('Erro ao salvar item do cardápio:', error);
      alert('Erro ao salvar');
    }
  };

  const handleDelete = async (id: string, recipeName: string) => {
    if (confirm(`Tem certeza que deseja remover "${recipeName}" do cardápio?`)) {
      try {
        const response = await fetch(`/api/admin/menu?id=${id}`, { method: 'DELETE' });
        if (response.ok) {
          await loadMenu();
          alert(`✅ "${recipeName}" removido do cardápio!`);
        } else {
          const error = await response.json();
          alert(error.error || 'Erro ao remover');
        }
      } catch (error) {
        console.error('Erro ao remover:', error);
        alert('Erro ao remover');
      }
    }
  };

  const resetForm = () => {
    setFormData({
      recipeId: '',
      dayOfWeek: null,
      period: null,
      customPrice: null,
      isAvailable: true
    });
    setEditingItem(null);
    setSelectedImage(null);
  };

  const editItem = (item: MenuItem) => {
    setEditingItem(item);
    setFormData({
      recipeId: item.recipeId,
      dayOfWeek: item.dayOfWeek ?? null,
      period: item.period ?? null,
      customPrice: item.customPrice ?? null,
      isAvailable: item.isAvailable
    });
    setSelectedImage(item.recipe?.image || null);
    setShowModal(true);
  };

  const handleRecipeChange = (recipeId: string) => {
    const selectedRecipe = recipes.find(r => r.id === recipeId);
    if (selectedRecipe) {
      setSelectedImage(selectedRecipe.image || null);
    } else {
      setSelectedImage(null);
    }
    setFormData({ ...formData, recipeId });
  };

  const getDayLabel = (day: number | null) => {
    if (day === null) return 'Todos os dias';
    return daysOfWeek.find(d => d.value === day)?.label || day.toString();
  };

  const getPeriodLabel = (period: string | null) => {
    if (period === null) return 'Todos os períodos';
    return periods.find(p => p.value === period)?.label || period;
  };

  if (loading) return <div className="p-8 text-center text-gray-900 dark:text-gray-100">Carregando cardápio...</div>;

  return (
    <div className="p-6">
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-2xl font-bold text-gray-900 dark:text-white">Cardápio Público</h1>
        <button
          onClick={() => {
            resetForm();
            setShowModal(true);
          }}
          className="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors"
        >
          + Adicionar ao Cardápio
        </button>
      </div>

      <div className="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead className="bg-gray-50 dark:bg-gray-700">
              <tr>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Imagem</th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Receita</th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dia</th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Período</th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Preço</th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th className="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-200 dark:divide-gray-700">
              {menuItems.length === 0 ? (
                <tr>
                  <td colSpan={7} className="px-6 py-8 text-center text-gray-500">
                    Nenhum item no cardápio. Adicione receitas ao cardápio!
                  </td>
                </tr>
              ) : (
                menuItems.map((item) => (
                  <tr key={item.id} className="hover:bg-gray-50 dark:hover:bg-gray-700">
                    <td className="px-4 py-3">
                      {item.recipe?.image ? (
                        <img 
                          src={item.recipe.image} 
                          alt={item.recipe.name} 
                          className="w-12 h-12 object-cover rounded-lg"
                        />
                      ) : (
                        <div className="w-12 h-12 bg-gray-200 dark:bg-gray-700 rounded-lg flex items-center justify-center">
                          <ImageIcon className="w-6 h-6 text-gray-400" />
                        </div>
                      )}
                    </td>
                    <td className="px-4 py-3">
                      <div className="font-medium text-gray-900 dark:text-white">{item.recipe?.name}</div>
                      <div className="text-xs text-gray-500 dark:text-gray-400">{item.recipe?.category}</div>
                      {item.recipe?.description && (
                        <div className="text-xs text-gray-400 mt-1 line-clamp-1">{item.recipe.description}</div>
                      )}
                    </td>
                    <td className="px-4 py-3 text-gray-600 dark:text-gray-300">{getDayLabel(item.dayOfWeek ?? null)}</td>
                    <td className="px-4 py-3 text-gray-600 dark:text-gray-300">{getPeriodLabel(item.period ?? null)}</td>
                    <td className="px-4 py-3 text-gray-600 dark:text-gray-300">
                      {item.customPrice 
                        ? `R$ ${item.customPrice.toFixed(2)}`
                        : `R$ ${item.recipe?.sellingPrice?.toFixed(2)}`}
                    </td>
                    <td className="px-4 py-3">
                      <span className={`px-2 py-1 rounded-full text-xs font-medium ${
                        item.isAvailable ? 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200' : 'bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200'
                      }`}>
                        {item.isAvailable ? 'Disponível' : 'Indisponível'}
                      </span>
                    </td>
                    <td className="px-4 py-3 text-right">
                      <button
                        onClick={() => editItem(item)}
                        className="text-blue-600 dark:text-blue-400 hover:text-blue-800 mr-3 transition-colors"
                      >
                        Editar
                      </button>
                      <button
                        onClick={() => handleDelete(item.id, item.recipe?.name || 'item')}
                        className="text-red-600 dark:text-red-400 hover:text-red-800 transition-colors"
                      >
                        Remover
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>

      {showModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white dark:bg-gray-800 rounded-lg p-6 w-full max-w-md max-h-[90vh] overflow-y-auto">
            <div className="flex justify-between items-center mb-4">
              <h2 className="text-xl font-bold text-gray-900 dark:text-white">
                {editingItem ? 'Editar Item do Cardápio' : 'Adicionar ao Cardápio'}
              </h2>
              <button onClick={() => { setShowModal(false); resetForm(); }} className="text-gray-500 hover:text-gray-700">
                <X size={20} />
              </button>
            </div>
            
            <form onSubmit={handleSubmit}>
              <div className="space-y-4">
                {selectedImage && (
                  <div className="flex justify-center mb-2">
                    <img 
                      src={selectedImage} 
                      alt="Prévia" 
                      className="w-32 h-32 object-cover rounded-lg shadow-md"
                    />
                  </div>
                )}
                
                <select
                  value={formData.recipeId}
                  onChange={(e) => handleRecipeChange(e.target.value)}
                  className="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500"
                  required
                >
                  <option value="">Selecione uma receita</option>
                  {recipes.map(recipe => (
                    <option key={recipe.id} value={recipe.id}>
                      {recipe.name} (R$ {recipe.sellingPrice.toFixed(2)})
                    </option>
                  ))}
                </select>
                
                {formData.recipeId && (
                  <div className="p-3 bg-gray-100 dark:bg-gray-700 rounded-lg">
                    <p className="text-sm text-gray-600 dark:text-gray-300">
                      {recipes.find(r => r.id === formData.recipeId)?.description || 'Sem descrição'}
                    </p>
                  </div>
                )}
                
                <select
                  value={formData.dayOfWeek === null ? '' : formData.dayOfWeek}
                  onChange={(e) => setFormData({ ...formData, dayOfWeek: e.target.value ? parseInt(e.target.value) : null })}
                  className="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500"
                >
                  {daysOfWeek.map(day => (
                    <option key={day.value ?? 'todos'} value={day.value ?? ''}>
                      {day.label}
                    </option>
                  ))}
                </select>
                
                <select
                  value={formData.period === null ? '' : formData.period}
                  onChange={(e) => setFormData({ ...formData, period: e.target.value ? e.target.value : null })}
                  className="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500"
                >
                  {periods.map(period => (
                    <option key={period.value ?? 'todos'} value={period.value ?? ''}>
                      {period.label}
                    </option>
                  ))}
                </select>
                
                <input
                  type="number"
                  step="0.01"
                  placeholder="Preço personalizado (opcional)"
                  value={formData.customPrice ?? ''}
                  onChange={(e) => setFormData({ ...formData, customPrice: e.target.value ? parseFloat(e.target.value) : null })}
                  className="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500"
                />
                
                <label className="flex items-center gap-2 text-gray-700 dark:text-gray-300">
                  <input
                    type="checkbox"
                    checked={formData.isAvailable}
                    onChange={(e) => setFormData({ ...formData, isAvailable: e.target.checked })}
                    className="w-4 h-4"
                  />
                  <span>Disponível para venda</span>
                </label>
              </div>
              
              <div className="flex justify-end gap-3 mt-6">
                <button
                  type="button"
                  onClick={() => {
                    setShowModal(false);
                    resetForm();
                  }}
                  className="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700"
                >
                  Salvar
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}