const API = '/api/cozinha';

export const CozinhaService = {
  getDashboard: async () => fetch(\\/dashboard\).then(r => r.json()),
  getRecipes: async () => fetch(\\/recipes\).then(r => r.json()),
  createRecipe: async (data: any) =>
    fetch(\\/recipes\, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    }).then(r => r.json()),

  getIngredients: async () =>
    fetch(\\/ingredients\).then(r => r.json()),

  getOrders: async () =>
    fetch(\\/orders\).then(r => r.json()),

  getShoppingList: async () =>
    fetch(\\/shopping-list\).then(r => r.json()),

  getStockMovements: async () =>
    fetch(\\/stock-movements\).then(r => r.json()),
};
